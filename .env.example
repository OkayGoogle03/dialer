# Copy to .env (git-ignored). Never commit real values.

# ---- Database: TiDB Cloud / MySQL 8 ----
DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=dev_dialer            # tests use <DB_NAME>_test (created/reset automatically)
DB_TLS=true
# TiDB Cloud Serverless prefixes every user name; leave empty for self-hosted MySQL/TiDB.
DB_USER_PREFIX=
# Owner: migrations + role setup ONLY (never given to the running API).
DB_OWNER_USER=
DB_OWNER_PASSWORD=
# Runtime users created by `pnpm db:setup-roles` (>= 16 chars each):
DB_API_PASSWORD=              # dialer_api: tenant-scoped, no write access to tenants/platform_admins/audit
DB_PLATFORM_PASSWORD=         # dialer_platform: cross-tenant; only platform module, outbox relay, consumers, CLI

# ---- API ----
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
TENANT_STATUS_CACHE_SECONDS=15

# ---- Events ----
NATS_URL=nats://localhost:4222
OUTBOX_RELAY_ENABLED=true     # run the outbox -> JetStream relay inside this API instance


# ---- Provider credential encryption (Phase 2): 32-byte base64 key ----
CREDENTIALS_ENCRYPTION_KEY=

{
  // One Worker serves the web app (static assets) and the API (Cloudflare Container).
  // Build command (dashboard): pnpm run build
  // Deploy command (dashboard):
  //   dialer      (dev branch):  npx wrangler deploy
  //   prod-dialer (main branch): npx wrangler deploy --name prod-dialer
  // "name" must match the Worker name shown in the Cloudflare dashboard. API settings/secrets: see docs/deployment.md.
  "name": "dialer",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    // React Router routes (/login, /caller-import, ...) must fall back to index.html
    "not_found_handling": "single-page-application",
    // API calls reach the Worker (which forwards them to the container) instead of being answered by the static assets
    "run_worker_first": ["/api/*"]
  },
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "./services/api/Dockerfile",
      "image_build_context": ".",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "ApiContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }]
}

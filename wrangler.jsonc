{
  // Cloudflare Workers static-assets deploy for the web app (apps/web).
  // Build command (dashboard): pnpm run build      Deploy command: npx wrangler deploy
  // "name" must match the Worker name shown in the Cloudflare dashboard.
  "name": "dialer",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/web/dist",
    // React Router routes (/login, /caller-import, ...) must fall back to index.html
    "not_found_handling": "single-page-application"
  }
}

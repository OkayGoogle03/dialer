{
  "name": "@dialer/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --env-file-if-exists=../../.env --watch -r ts-node/register/transpile-only -r tsconfig-paths/register src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --env-file-if-exists=../../.env node_modules/jest/bin/jest.js --runInBand",
    "provision": "node --env-file-if-exists=../../.env -r ts-node/register/transpile-only -r tsconfig-paths/register src/cli/provision-tenant.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testTimeout": 120000,
    "moduleNameMapper": {
      "^@dialer/([a-z-]+)$": "<rootDir>/../../packages/$1/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "globalSetup": "<rootDir>/test/global-setup.ts"
  },
  "dependencies": {
    "@dialer/event-schemas": "workspace:*",
    "@dialer/shared-types": "workspace:*",
    "@dialer/validation": "workspace:*",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nats": "^2.29.3",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "jszip": "^3.10.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3"
  }
}

{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "sourceMap": true,
    "strictPropertyInitialization": false,
    "useUnknownInCatchVariables": true,
    "types": [
      "node",
      "jest"
    ],
    "baseUrl": ".",
    "paths": {
      "@dialer/*": [
        "../../packages/*/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
